{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Jwt": {
    "Issuer": "Pedidos.Api",
    "Audience": "Pedidos.Client",
    "Key": "",
    "ExpiracionEnMinutos": 60
  },
  "Cors": {
    "OrigenesPermitidos": [
      "http://localhost:5173"
    ]
  },
  "RateLimiting": {
    "IntentosDeLoginPorVentana": 5,
    "VentanaDeLoginEnMinutos": 1,
    "PeticionesDeApiPorVentana": 100,
    "VentanaDeApiEnMinutos": 1
  },
  "Resiliencia": {
    "ReintentosMaximos": 3,
    "RetardoBaseEnMilisegundos": 200,
    "TimeoutDeLecturaEnSegundos": 10,
    "TimeoutDeEscrituraEnSegundos": 15,
    "ProporcionDeFallosParaAbrir": 0.5,
    "MuestrasMinimasParaAbrir": 8,
    "VentanaDeMuestreoEnSegundos": 30,
    "DuracionDeAperturaEnSegundos": 15
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  }
}
